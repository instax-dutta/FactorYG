{
  "name": "factor-y",
  "private": true,
  "version": "0.1.0",
  "description": "A 2.5D isometric idle factory game for the browser, built with React and three.js.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/instax-dutta/factor-y#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instax-dutta/factor-y.git"
  },
  "bugs": {
    "url": "https://github.com/instax-dutta/factor-y/issues"
  },
  "keywords": [
    "game",
    "idle-game",
    "factory",
    "automation",
    "threejs",
    "react",
    "typescript",
    "isometric"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
